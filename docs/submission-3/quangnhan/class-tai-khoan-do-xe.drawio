ign=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1340" y="2012" width="300" height="86" as="geometry"/></mxCell><mxCell id="pk_114" value="- sent: boolean&lt;br&gt;- failedRecipientIds: String[]" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;fontFamily=Courier New;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="pk_113"><mxGeometry y="44" width="300" height="40" as="geometry"/></mxCell><mxCell id="pk_115" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;Giữ tạm (HELD) và đặt chỗ đã xác nhận (CONFIRMED) là CÙNG MỘT bản ghi ParkingAllocation; holdToken = id của bản ghi đó. Hạn giữ = min(now + parkingHoldMinutes, startTime).&lt;br&gt;requestId: client sinh cho mỗi lần bấm xác nhận. Các method atomic... kiểm tra requestId trong ProcessedRequest (entity dùng chung, xem sơ đồ của Hoàng Nhân) và ghi trong cùng transaction: gửi lặp thì trả kết quả cũ.&lt;br&gt;Trip, SharedVehicle thuộc subsystem Xe dùng chung (Linh); ở đây chỉ vẽ phần UC05 cần." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fffbe6;strokeColor=#b8a24f;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="1632" width="330" height="158" as="geometry"/></mxCell><mxCell id="pk_116" value="&lt;b&gt;Bước nội bộ trong sequence (nằm trong thân method Service)&lt;/b&gt;&lt;br&gt;ParkingService.holdSlot: recheckReservationConditions, computeHoldDeadline.&lt;br&gt;ReturnService.prepareReturn: validateTripForReturn, selectReturnSlot.&lt;br&gt;ReturnService.confirmReturn: verifyVehicleHubAndSlot, determineVehicleServiceStatus.&lt;