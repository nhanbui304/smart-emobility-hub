xt;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;fontFamily=Courier New;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="ov_195"><mxGeometry y="44" width="247" height="236" as="geometry"/></mxCell><mxCell id="ov_197" value="«enumeration»&lt;br&gt;&lt;b&gt;AlertType&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="2380" y="2814" width="220" height="114" as="geometry"/></mxCell><mxCell id="ov_198" value="LOW_VEHICLE&lt;br&gt;NEAR_FULL&lt;br&gt;RESOURCE_FAULT&lt;br&gt;DATA_STALE" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;fontFamily=Courier New;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="ov_197"><mxGeometry y="44" width="220" height="68" as="geometry"/></mxCell><mxCell id="ov_199" value="&lt;b&gt;Ghi chú – sơ đồ tổng thể&lt;/b&gt;&lt;br&gt;Chỉ gồm Entity, Service và Enum của cả hệ thống. View, Controller, Repository và các datatype tham số / kết quả xem ở 4 sơ đồ chi tiết theo subsystem.&lt;br&gt;Sau tên stereotype của mỗi Service là người phụ trách.&lt;br&gt;User: Student và Operator phân biệt bằng role (một bảng users).&lt;br&gt;Json: dữ liệu lưu dạng JSON (phương án xử lý sự cố, kế hoạch sạc, bản chụp và kết quả mô phỏng).&lt;br&gt;Không vẽ đường cho khóa ngoại ghi vết người thao tác (createdBy, appliedBy, reportedBy, operatorId, actorId), RedistributionOrder → Hub (sourceHubId, targetHubId), Trip → Hub / ParkingSlot (returnHubId, returnSlotId), ChargingRequest → Hub và Incident.resourceId (trỏ tới xe, vị trí hoặc cổng tùy resourceType).&lt;br&gt;Thuộc tính trạng thái / loại có kiểu là Enum cùng tên ở khu Enum.&lt;br&gt;ProcessedRequest: chống gửi lặp bằng requestId cho các thao tác ghi (UC02, UC04–UC06, UC08, UC09, UC11, UC13, UC14)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fffbe6;strokeColor=#b8a24f;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1720" y="1100" width="520" height="200" as="geometry"/></mxCell><mxCell id="ov_200" value="" style="endArrow=none;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;strokeColor=#333333;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=1;exitY=0;exitDy=60;entryX=0;entryY=0;entryDy=60;" edge="1" parent="1" source="ov_129" target="ov_81"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ov_201" value="cảnh báo" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368" y="203" width="64" height="18" as="geometry"/></mxCell><mxCell id="ov_202" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=none;" vertex="1" connectable="0" parent="ov_200"><mxGeometry x="-0.8" y="-12" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="ov_203" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=none;" vertex="1" connectable="0" parent="ov_200"><mxGeometry x="0.8" y="-12" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="ov_204" value="" style="endArrow=none;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;strokeColor=#333333;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=1;exitY=0;exitDy=60;entryX=0;entryY=0;entryDy=60;