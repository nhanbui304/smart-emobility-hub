# Cổng chạy API + Socket.IO
PORT=3000
# Đường dẫn file SQLite (tính từ thư mục server/)
DATABASE_URL=./data/dev.db
# Khóa ký JWT – đổi chuỗi này nếu triển khai thật
JWT_SECRET=doi-chuoi-nay-khi-trien-khai
JWT_EXPIRES_IN=8h
# Địa chỉ client được phép gọi API (CORS)
CLIENT_ORIGIN=http://localhost:5173
# Bật/tắt bộ giả lập xe (true/false)
SIMULATOR_ENABLED=true
