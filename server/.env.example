# Cổng chạy API
PORT=3000
# Đường dẫn file SQLite (tính từ thư mục server/)
DATABASE_URL=./data/dev.db
# Dev tự sinh khóa phiên khi bỏ trống. Production cần khóa ngẫu nhiên ít nhất 32 ký tự.
SESSION_SECRET=
# Bật/tắt bộ giả lập xe (true/false)
SIMULATOR_ENABLED=true
# Kết quả lệnh mở/khóa xe của bộ giả lập: RANDOM (90% thành công) | SUCCESS | FAILED | UNKNOWN
# Đặt FAILED hoặc UNKNOWN để demo nhánh lỗi UC04, UC05
SIMULATOR_DEVICE_RESULT=RANDOM
# Thời gian giữ tạm chỗ đỗ (phút), mặc định 30. Đặt 1 khi kiểm thử TC-2.3.1-01
# PARKING_HOLD_MINUTES=1
